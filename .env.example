# Public frontend configuration. Copy this file to .env and fill in the values.
# Never place Stripe secret keys, webhook secrets or Supabase service-role keys here.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Stripe-hosted customer portal login URL.
VITE_STRIPE_CUSTOMER_PORTAL_URL="https://billing.stripe.com/p/login/your-link"
